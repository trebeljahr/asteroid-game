{
  // The web client, served by Cloudflare Workers static assets on the route
  // asteroids.trebeljahr.com/*. /trpc/*, /socket.io/* and
  // /.well-known/acme-challenge/* have routes with no Worker, so they reach
  // the game server on Coolify (/trpc/* also carries the browser's error
  // reports, /trpc/client-errors). The routes are made in the Cloudflare
  // dashboard or API, never here: with no "routes" key wrangler leaves them
  // alone.
  //
  // Do not add "main", "run_worker_first" or "cache": each one turns free
  // asset requests into counted Worker requests (Workers Free: 100,000 a
  // day per account; over the cap run_worker_first paths answer 429).
  "name": "asteroid-game-client",
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": "./client/dist",
    // client/public/404.html for unknown paths, never an SPA fallback: the
    // game has one page.
    "not_found_handling": "404-page"
  },
  "workers_dev": false
}

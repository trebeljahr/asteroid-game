{
  "name": "asteroid-game",
  "version": "1.0.0",
  "packageManager": "pnpm@10.33.2",
  "private": true,
  "description": "Fly through asteroid fields in your browser: race the clock alone, duel one player, or fight up to 19 others.",
  "homepage": "https://asteroids.trebeljahr.com",
  "bugs": {
    "url": "https://github.com/trebeljahr/asteroid-game/issues"
  },
  "scripts": {
    "setup": "node ./scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:fixed": "node scripts/dev.mjs --fixed",
    "dev:lan": "node scripts/dev.mjs --fixed --lan",
    "dev:no-deps": "node scripts/dev.mjs --no-deps",
    "dev:down": "node scripts/dev-down.mjs",
    "start": "pnpm dev",
    "dev:client": "pnpm --filter @simple-asteroid-game/client dev",
    "dev:server": "pnpm --filter @simple-asteroid-game/server dev",
    "build": "pnpm --filter @simple-asteroid-game/client build && pnpm --filter @simple-asteroid-game/server build",
    "build:client": "pnpm --filter @simple-asteroid-game/client build",
    "build:server": "pnpm --filter @simple-asteroid-game/server build",
    "check": "pnpm --filter @simple-asteroid-game/shared check && pnpm --filter @simple-asteroid-game/client check && pnpm --filter @simple-asteroid-game/server check",
    "test:runtime-security": "node --test scripts/runtime-security.test.cjs",
    "tools:extract-shapes": "tsx scripts/extract-ship-shapes.ts",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "prepare": "husky",
    "backup:status": "hatchkit backup status --project asteroid-game",
    "backup:list": "hatchkit backup snapshots --project asteroid-game",
    "backup:restore": "hatchkit backup restore --project asteroid-game",
    "test:server": "pnpm --filter @simple-asteroid-game/server test",
    "test:client": "pnpm --filter @simple-asteroid-game/client test",
    "marketing:screenshots": "node scripts/marketing/capture-screenshots.mjs",
    "marketing:social-preview": "node scripts/marketing/render-social-preview.mjs",
    "proof:handoff": "node scripts/handoff-proof/run.mjs",
    "proof:stack": "node scripts/handoff-proof/stack.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trebeljahr/asteroid-game.git"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  },
  "author": "Rico Trebeljahr",
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "concurrently": "^5.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "tsx": "^4.23.15"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "pnpm": {
    "overrides": {
      "@rollup/plugin-terser>serialize-javascript": "7.0.5",
      "@esbuild-kit/core-utils>esbuild": "0.28.1",
      "body-parser@1": "1.20.9",
      "zod@4": "4.6.6"
    }
  }
}
